# Google OAuth (For Google Drive & Sheets Sync)
GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"

# NextAuth / Security
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your_nextauth_secret_random_string"
# 64-character hex string, for example: openssl rand -hex 32
ENCRYPTION_KEY="your_encryption_key_64_chars_hex"

# Service Account (For Demo Mode / Bot Sync)
GOOGLE_SERVICE_ACCOUNT_EMAIL="your_service_account_email@developer.gserviceaccount.com"
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour\nGiant\nKey\n-----END PRIVATE KEY-----\n"

# AI Provider Keys (At least one is required if not using BYOK)
# Extraction tries saved/BYOK first, then GROQ_API_KEY, OPENAI_API_KEY, and GEMINI_API_KEY.
# Keep at least two providers configured for demo resilience if one provider hits quota.
OPENAI_API_KEY="sk-..."
GROQ_API_KEY="gsk_..."
GEMINI_API_KEY="AIza..."

# Optional demo safety valve: return seeded mock extraction instead of failing when all
# configured AI providers are out of quota/rate-limited.
DEMO_FALLBACK_ON_AI_QUOTA="false"
