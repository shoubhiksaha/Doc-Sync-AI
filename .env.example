# ── Google OAuth (signed-in users: their own Sheets & Drive) ────────────────
GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"

# ── NextAuth / Security ─────────────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
# Also signs demo (guest) sessions.
NEXTAUTH_SECRET="your_nextauth_secret_random_string"
# 64-character hex string, for example: openssl rand -hex 32
ENCRYPTION_KEY="your_encryption_key_64_chars_hex"

# ── Demo mode (no login) ────────────────────────────────────────────────────
# Service account used only for demo users. Demo users write ONLY to GOOGLE_SHEET_ID
# (or a "DocSync AI Demo Data" sheet inside GOOGLE_SHARED_FOLDER_ID).
GOOGLE_SERVICE_ACCOUNT_EMAIL="your_service_account_email@developer.gserviceaccount.com"
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour\nGiant\nKey\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID=""
# GOOGLE_SHARED_FOLDER_ID=""
# Max AI calls per day across all demo users (0 disables demo AI calls).
DEMO_DAILY_AI_LIMIT="300"
# Demo images/voice notes are NOT stored by default. "true" uploads them to Catbox.moe,
# a PUBLIC, permanent, anonymous host — only enable for non-sensitive demo documents.
DEMO_PUBLIC_MEDIA_UPLOAD="false"
# Return sample data instead of failing when every AI provider is out of quota.
DEMO_FALLBACK_ON_AI_QUOTA="false"

# ── AI providers (at least one, unless every user brings their own key) ─────
# Order tried: user's saved key, then GROQ, OPENAI, GEMINI, ANTHROPIC. Any provider error
# moves on to the next one, so configure two or more for resilience.
OPENAI_API_KEY="sk-..."
GROQ_API_KEY="gsk_..."
GEMINI_API_KEY="AIza..."
# ANTHROPIC_API_KEY="sk-ant-..."
# Optional model overrides per environment:
# OPENAI_VISION_MODEL="gpt-4o"
# GEMINI_VISION_MODEL="gemini-3.6-flash"
# GROQ_VISION_MODEL="qwen/qwen3.8-27b"
# ANTHROPIC_VISION_MODEL="claude-sonnet-5-5"

# ── Notion (optional) ───────────────────────────────────────────────────────
# NOTION_CLIENT_ID=""
# NOTION_CLIENT_SECRET=""
# Server-wide fallback database (otherwise each user connects their own via OAuth):
# NOTION_API_KEY=""
# NOTION_DATABASE_ID=""

# ── Persistent settings (optional, Firestore) ───────────────────────────────
# FIREBASE_PROJECT_ID=""
# FIREBASE_CLIENT_EMAIL=""   # defaults to GOOGLE_SERVICE_ACCOUNT_EMAIL
# FIREBASE_PRIVATE_KEY=""    # defaults to GOOGLE_PRIVATE_KEY
# "staging" on the staging environment, "(default)" in production.
# FIRESTORE_DATABASE_ID="(default)"

# ── Rate limiting (optional; shared across instances when set) ──────────────
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""

# ── Environment & kill switches ─────────────────────────────────────────────
# APP_ENV is derived from VERCEL_ENV (production / preview→staging) when unset.
# APP_ENV="staging"
# Turn any module off without a code change (redeploy to apply on Vercel):
# MODULE_AI / MODULE_EXTRACTION / MODULE_TRANSCRIPTION / MODULE_SHEETS /
# MODULE_NOTION / MODULE_MEDIA / MODULE_SETTINGS / MODULE_DEMO = "off"
